# Run umask 077 before copying this file, so .env is private.
# Single-quote every value: this file is sourced as shell; an unquoted & in a URL
# cuts the value and runs the rest as a command. Copy to .env, fill in, then
# start ./run.sh, which loads it on every start.
# NEVER commit the real .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_KEY=
ALLOWED_CHAT_ID=
OWNER_USER_ID=
REPLY_CAP='10'
# Keep state outside the checkout; this is the default.
# RELAY_STATE_DIR='~/.local/state/telegram-bot-relay'

# Recent messages per allowed chat; 0 disables history.
HISTORY_SIZE='20'
# Characters kept per history text, plus ... when truncated.
HISTORY_MAX_CHARS='1000'

# Optional comma list of user ids; owner always allowed.
ALLOWED_SENDER_IDS=
# 1 forwards edits; edits can replay old instructions.
FORWARD_EDITS='0'
# 1 forwards media-only photos, documents, voice, audio and video.
FORWARD_MEDIA='1'
# SENT_LOG='sent.jsonl'   # agent-written log of the bot's own replies; relative to RELAY_STATE_DIR

# Forward attempts for 5xx, 429 and network errors before an update is dropped.
FORWARD_RETRIES='5'
# run.sh restarts relay.py when its heartbeat stops changing for this many seconds.
HEARTBEAT_MAX_AGE='180'

# Exit for restart after this many seconds without a successful poll; at least 60.
POLL_STALL_MAX='180'
